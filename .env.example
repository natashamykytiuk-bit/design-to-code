# Copy to .env.local and pick one setup. Leave everything unset to hide cloud features.

# Local dev: run the API (`npm run dev` in backend/ or `docker compose up`).
# Requests go through the Vite proxy; sign-in is replaced by a dev user.
VITE_API_URL=/api

# AWS: use the values from `terraform -chdir=infra output`.
# VITE_API_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com
# VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
